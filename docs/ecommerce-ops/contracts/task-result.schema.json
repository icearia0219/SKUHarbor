{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opendot:ecommerce:task-result:1.0",
  "title": "OpenDot Ecommerce Task Result v1.0",
  "description": "Generated draft contract; permissions, evidence truth, stale dependencies and human review are enforced by the server. Not an Amazon submission schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "enum": [
        "research_brief",
        "listing_pack",
        "ad_pack",
        "ads_diagnosis",
        "support_draft"
      ]
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "market": {
      "enum": [
        "US",
        "DE"
      ]
    },
    "locale": {
      "enum": [
        "en-US",
        "de-DE"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "product_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product_ref"
      },
      "minItems": 0
    },
    "input_revision": {
      "type": "string",
      "minLength": 1
    },
    "policy_snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "needs_input",
        "blocked",
        "failed"
      ]
    },
    "payload": {
      "type": [
        "object",
        "null"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      },
      "minItems": 0
    },
    "usage": {
      "$ref": "#/$defs/usage"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "task_type",
    "workspace_id",
    "market",
    "locale",
    "as_of",
    "product_refs",
    "input_revision",
    "policy_snapshot_id",
    "status",
    "payload",
    "claims",
    "evidence",
    "issues",
    "usage"
  ],
  "$defs": {
    "issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "blocking"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "field"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "product_fact",
            "policy",
            "brand",
            "competitor",
            "report",
            "order",
            "ticket",
            "experience"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "enum": [
            "real",
            "redacted",
            "synthetic",
            "public"
          ]
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "kind",
        "locator",
        "content_hash",
        "provenance",
        "excerpt"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "field_path": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "claim_id",
        "text",
        "field_path",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "product_ref": {
      "type": "object",
      "properties": {
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "sku": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "market": {
          "enum": [
            "US",
            "DE"
          ]
        }
      },
      "required": [
        "product_id",
        "sku",
        "revision",
        "market"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "model_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "model_elapsed_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "price_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "model_ref",
        "input_tokens",
        "output_tokens",
        "retry_count",
        "model_elapsed_ms",
        "cost_usd",
        "price_version"
      ],
      "additionalProperties": false
    },
    "research_brief": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidate_ref": {
                "type": "string",
                "minLength": 1
              },
              "supported_facts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "differences": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "missing_evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            },
            "required": [
              "candidate_ref",
              "supported_facts",
              "differences",
              "missing_evidence"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "comparison_summary": {
          "type": "string",
          "minLength": 1
        },
        "next_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "candidates",
        "comparison_summary",
        "next_questions"
      ],
      "additionalProperties": false
    },
    "listing_pack": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "bullets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "search_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "rule_coverage": {
          "enum": [
            "partial",
            "profile_checked"
          ]
        },
        "unchecked_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "title",
        "bullets",
        "description",
        "search_terms",
        "rule_coverage",
        "unchecked_rules"
      ],
      "additionalProperties": false
    },
    "ad_pack": {
      "type": "object",
      "properties": {
        "placement": {
          "type": "string",
          "minLength": 1
        },
        "copies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "headline": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string",
                "minLength": 1
              },
              "cta": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "headline",
              "body",
              "cta"
            ],
            "additionalProperties": false
          },
          "minItems": 3,
          "maxItems": 3
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term": {
                "type": "string",
                "minLength": 1
              },
              "origin": {
                "type": "string",
                "minLength": 1
              },
              "use": {
                "enum": [
                  "research_candidate",
                  "copy_candidate"
                ]
              }
            },
            "required": [
              "term",
              "origin",
              "use"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "rule_coverage": {
          "enum": [
            "internal_draft",
            "profile_checked"
          ]
        },
        "unchecked_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "placement",
        "copies",
        "keywords",
        "rule_coverage",
        "unchecked_rules"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "currency": {
          "enum": [
            "USD",
            "EUR"
          ]
        },
        "spend_minor": {
          "type": "integer",
          "minimum": 0
        },
        "attributed_sales_minor": {
          "type": "integer",
          "minimum": 0
        },
        "impressions": {
          "type": "integer",
          "minimum": 0
        },
        "clicks": {
          "type": "integer",
          "minimum": 0
        },
        "attributed_orders": {
          "type": "integer",
          "minimum": 0
        },
        "acos_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "roas": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "ctr_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cpc_minor": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cvr_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "currency",
        "spend_minor",
        "attributed_sales_minor",
        "impressions",
        "clicks",
        "attributed_orders",
        "acos_ratio",
        "roas",
        "ctr_ratio",
        "cpc_minor",
        "cvr_ratio"
      ],
      "additionalProperties": false
    },
    "ads_diagnosis": {
      "type": "object",
      "properties": {
        "report_id": {
          "type": "string",
          "minLength": 1
        },
        "metrics_ref": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "maturity": {
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "action_draft": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "code",
              "message",
              "evidence_refs",
              "action_draft"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "missing_context": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "report_id",
        "metrics_ref",
        "metrics",
        "maturity",
        "findings",
        "missing_context"
      ],
      "additionalProperties": false
    },
    "support_draft": {
      "type": "object",
      "properties": {
        "ticket_id": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "reply_body": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "reply_draft",
            "needs_info",
            "escalate"
          ]
        },
        "order_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "internal_notes_zh": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "ticket_id",
        "intent",
        "reply_body",
        "action",
        "order_evidence_refs",
        "internal_notes_zh"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "market": {
            "const": "US"
          }
        },
        "required": [
          "market"
        ]
      },
      "then": {
        "properties": {
          "locale": {
            "const": "en-US"
          },
          "product_refs": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/product_ref"
                },
                {
                  "properties": {
                    "market": {
                      "const": "US"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "market": {
            "const": "DE"
          }
        },
        "required": [
          "market"
        ]
      },
      "then": {
        "properties": {
          "locale": {
            "const": "de-DE"
          },
          "product_refs": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/product_ref"
                },
                {
                  "properties": {
                    "market": {
                      "const": "DE"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_type": {
            "const": "research_brief"
          },
          "status": {
            "const": "draft"
          }
        },
        "required": [
          "task_type",
          "status"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/research_brief"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_type": {
            "const": "listing_pack"
          },
          "status": {
            "const": "draft"
          }
        },
        "required": [
          "task_type",
          "status"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/listing_pack"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_type": {
            "const": "ad_pack"
          },
          "status": {
            "const": "draft"
          }
        },
        "required": [
          "task_type",
          "status"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/ad_pack"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_type": {
            "const": "ads_diagnosis"
          },
          "status": {
            "const": "draft"
          }
        },
        "required": [
          "task_type",
          "status"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/ads_diagnosis"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_type": {
            "const": "support_draft"
          },
          "status": {
            "const": "draft"
          }
        },
        "required": [
          "task_type",
          "status"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/support_draft"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "needs_input",
              "blocked",
              "failed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "null"
          },
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
